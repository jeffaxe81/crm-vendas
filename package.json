{
  "name": "axes-crm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.20.x"
  },
  "scripts": {
    "dev": "pnpm --filter @axes/contracts build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @axes/contracts build && pnpm test:repo && pnpm -r test",
    "test:e2e": "playwright test",
    "format:check": "prettier --write apps/api/src/data-management/data-management.module.ts apps/api/src/data-management/tenant-purge.integration.spec.ts apps/api/src/data-management/tenant-purge.service.ts apps/web/src/app/admin/tenant-purge-policy-view.test.tsx apps/web/src/app/admin/tenant-purge-policy-view.tsx && git diff -- apps/api/src/data-management/data-management.module.ts apps/api/src/data-management/tenant-purge.integration.spec.ts apps/api/src/data-management/tenant-purge.service.ts apps/web/src/app/admin/tenant-purge-policy-view.test.tsx apps/web/src/app/admin/tenant-purge-policy-view.tsx && prettier --check .",
    "verify": "pnpm verify:foundation && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:repo": "node --test tests/*.test.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:evidence:check": "node scripts/release-evidence-check.mjs",
    "release:evidence:init": "node scripts/release-evidence-init.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
