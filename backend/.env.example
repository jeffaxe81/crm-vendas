# Variáveis para rodar o backend FastAPI FORA do Docker (uvicorn/pytest locais).
# Dentro do docker-compose elas já são definidas pelo docker-compose.yml.
DATABASE_URL=postgresql://vendas_user:vendas_pass_dev@localhost:5432/crm_vendas_dev
# Banco descartável para os testes — o nome PRECISA terminar em _test
TEST_DATABASE_URL=postgresql://vendas_user:vendas_pass_dev@localhost:5432/crm_vendas_dev_test
ENVIRONMENT=development
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
