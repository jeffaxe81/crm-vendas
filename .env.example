NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://axes:axes@localhost:5432/axes_crm

# Restricted, non-superuser role for the running app (not migrations).
# The superuser above has BYPASSRLS by nature and would silently defeat
# every Row-Level Security tenant policy — this role can't bypass RLS.
# Created automatically by postgres-init/01-create-app-role.sh on first boot.
APP_DB_USER=axes_app
APP_DB_PASSWORD=change-me
APP_DATABASE_URL=postgresql://axes_app:change-me@localhost:5432/axes_crm
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000

# Apenas desenvolvimento local. Substitua por valores aleatórios em qualquer ambiente real.
JWT_ACCESS_SECRET=local-only-access-secret-change-before-real-use
REFRESH_TOKEN_PEPPER=local-only-refresh-pepper-change-before-real-use
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# Bootstrap explícito do primeiro administrador. Defina a senha antes de executar.
BOOTSTRAP_ORG_NAME=Axesistemas
BOOTSTRAP_ORG_SLUG=axesistemas
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
