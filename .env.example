NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Superusuário do Postgres (dono do schema; usado por migrations e db-bootstrap).
# Em um volume já existente, mantenha os valores com que ele foi criado.
POSTGRES_DB=axes_crm
POSTGRES_USER=axes
POSTGRES_PASSWORD=axes
DATABASE_URL=postgresql://axes:axes@localhost:5432/axes_crm

# Restricted, non-superuser role for the running app (not migrations).
# The superuser above has BYPASSRLS by nature and would silently defeat
# every Row-Level Security tenant policy — this role can't bypass RLS.
# Criado/atualizado por postgres-init/01-create-app-role.sh — na primeira
# inicialização do volume e, via serviço db-bootstrap, a cada `docker compose up`.
# Pode ser trocada a qualquer momento: a senha do role é ressincronizada na subida.
# Prefira apenas letras e números (evita codificação na URL de conexão).
APP_DB_USER=axes_app
APP_DB_PASSWORD=change-me
APP_DATABASE_URL=postgresql://axes_app:change-me@localhost:5432/axes_crm

# Endereço em que as portas 3000/3001/5432 são publicadas no host.
# 127.0.0.1 (padrão) = só local; acesso externo apenas pelo Nginx/HTTPS.
BIND_ADDRESS=127.0.0.1

# Desenvolvimento local (sem Nginx):
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000
# Servidor atrás do Nginx/HTTPS (ver docs/deploy/deploy-https.md) — exemplo:
#   NEXT_PUBLIC_API_BASE_URL=https://192.168.40.84/api/v1   (exige rebuild do web)
#   WEB_ORIGIN=https://192.168.40.84

# Apenas desenvolvimento local. Substitua por valores aleatórios em qualquer ambiente real.
JWT_ACCESS_SECRET=local-only-access-secret-change-before-real-use
REFRESH_TOKEN_PEPPER=local-only-refresh-pepper-change-before-real-use
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# Bootstrap explícito do primeiro administrador. Defina a senha antes de executar.
BOOTSTRAP_ORG_NAME=Axesistemas
BOOTSTRAP_ORG_SLUG=axesistemas
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Stack FastAPI (docker-compose.fastapi.yml): backend Python + PostgreSQL 14 + Redis
# Estas variáveis são lidas pelo docker-compose.fastapi.yml. Os valores abaixo são os
# padrões de desenvolvimento; o backend monta a própria DATABASE_URL a partir
# delas (postgresql://DB_USER:DB_PASSWORD@postgres:5432/DB_NAME).
# ─────────────────────────────────────────────────────────────────────────────
DB_USER=vendas_user
DB_PASSWORD=vendas_pass_dev
DB_NAME=crm_vendas_dev
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
ENVIRONMENT=development
# Obrigatório trocar fora de development (o backend recusa iniciar com o padrão).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NEO Interact incorporado: URL HTTPS do ambiente autorizado, sem credenciais ou tokens.
# Exemplo do Dispatch: https://gscprj.saas.digitro.cloud/neo/
# Deixe vazio para manter a comunicação desconfigurada. Configuração lida em runtime.
NEO_INTERACT_URL=
# Use tab para abrir em outra aba quando o NEO bloquear a incorporação.
NEO_INTERACT_MODE=iframe
# Dimensões em pixels (inteiros de 320 a 1600), utilizadas no modo iframe.
NEO_INTERACT_FRAME_HEIGHT=800
NEO_INTERACT_FRAME_MAX_WIDTH=1600
